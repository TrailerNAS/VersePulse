<Window
    x:Class="VersePulse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VersePulse"
    Width="390"
    Height="469"
    MinWidth="390"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#10151C"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid
        Margin="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

        <Border
            Padding="20"
            CornerRadius="14"
            Background="#18212B"
            BorderBrush="#344454"
            BorderThickness="1"
            CacheMode="BitmapCache">

            <StackPanel>

                <TextBlock
                    Text="VersePulse"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="STAR CITIZEN SERVER HEALTH"
                    Margin="0,4,0,22"
                    FontSize="11"
                    Foreground="#8FA7BB"
                    HorizontalAlignment="Center"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <!-- Game Status -->

                    <TextBlock
                        Text="Star Citizen"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="GameStatusText"
                        Grid.Column="1"
                        Text="Game closed"
                        Foreground="#F0B35A"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Client FPS -->

                    <TextBlock
                        Grid.Row="1"
                        Text="Client FPS"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="ClientFPSText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="--"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Server FPS -->

                    <TextBlock
                        Grid.Row="2"
                        Text="Server FPS"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="ServerFPSText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="--"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Ping -->

                    <TextBlock
                        Grid.Row="3"
                        Text="Ping"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="PingText"
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="-- ms"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- CPU Usage -->

                    <TextBlock
                        Grid.Row="4"
                        Text="CPU Usage"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="CpuUsageText"
                        Grid.Row="4"
                        Grid.Column="1"
                        Text="-- %"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- RAM Usage -->

                    <TextBlock
                        Grid.Row="5"
                        Text="RAM Usage"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="RamUsageText"
                        Grid.Row="5"
                        Grid.Column="1"
                        Text="-- MB"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <!-- Committed Memory -->

                    <TextBlock
                        Grid.Row="6"
                        Text="Committed Memory"
                        Foreground="#B8C7D3"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="CommittedMemoryText"
                        Grid.Row="6"
                        Grid.Column="1"
                        Text="-- MB"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</Window>