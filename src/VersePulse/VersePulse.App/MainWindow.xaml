<Window x:Class="VersePulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VersePulse"
        Width="390"
        Height="431"
        MinHeight="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#10151C">

    <Border Margin="14"
            Padding="20"
            CornerRadius="14"
            Background="#18212B"
            BorderBrush="#344454"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="VersePulse"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="STAR CITIZEN SERVER HEALTH"
                       Margin="0,4,0,22"
                       FontSize="11"
                       Foreground="#8FA7BB"
                       HorizontalAlignment="Center"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Star Citizen"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="GameStatusText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Game closed"
                           Foreground="#F0B35A"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Text="Client FPS"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="--"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Text="Server FPS"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="--"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3"
                           Text="Ping"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="-- ms"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="DeveloperModeButton"
                    Content="Show Developer Diagnostics"
                    Margin="0,18,0,0"
                    Height="34"
                    Click="DeveloperModeButton_Click"/>

            <Border x:Name="DeveloperPanel"
                    Visibility="Collapsed"
                    Margin="0,14,0,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="#101820"
                    BorderBrush="#344454"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="DEVELOPER DIAGNOSTICS"
                               Margin="0,0,0,12"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#8FCBFF"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="State"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="DeveloperStateText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="--"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="1"
                                   Text="Session"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="SessionText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="--"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <TextBlock Grid.Row="2"
                                   Text="Environment"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="EnvironmentText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Text="--"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <TextBlock Grid.Row="3"
                                   Text="Region"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="RegionText"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Text="--"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="4"
                                   Text="Lines parsed"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="LinesParsedText"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Text="0"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="5"
                                   Text="Last event"
                                   Foreground="#8FA7BB"/>

                        <TextBlock x:Name="LastEventText"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   Text="Waiting..."
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock Text="Star Citizen executable"
                               Margin="0,10,0,4"
                               Foreground="#8FA7BB"/>

                    <TextBlock x:Name="GameLocationText"
                               Text="--"
                               FontSize="10"
                               Foreground="#B8C7D3"
                               TextWrapping="Wrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                    <Button Content="Change Star Citizen Location"
                            Margin="0,10,0,0"
                            Height="30"
                            Click="ChangeGameLocationButton_Click"/>

                    <TextBlock Text="Log file"
                               Margin="0,12,0,4"
                               Foreground="#8FA7BB"/>

                    <TextBlock x:Name="LogFileText"
                               Text="--"
                               FontSize="10"
                               Foreground="#B8C7D3"
                               TextWrapping="Wrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>