<Window x:Class="VersePulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VersePulse"
        Width="350"
        Height="475"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#10151C">

    <Border Margin="14,14,14,14"
            Padding="20"
            CornerRadius="14"
            Background="#18212B"
            BorderBrush="#344454"
            BorderThickness="1">

        <StackPanel Height="378" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.204"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.593"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <TextBlock Text="VersePulse"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="STAR CITIZEN SERVER HEALTH"
                       Margin="0,4,0,22"
                       FontSize="11"
                       Foreground="#8FA7BB"
                       HorizontalAlignment="Center"/>

            <!-- Main telemetry -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <!-- Game status -->
                <TextBlock Grid.Row="0"
                           Text="Star Citizen"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="GameStatusText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Game closed"
                           Foreground="#F0B35A"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Client FPS -->
                <TextBlock Grid.Row="1"
                           Text="Client FPS"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ClientFPSText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="--"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Server FPS -->
                <TextBlock Grid.Row="2"
                           Text="Server FPS"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="--"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Ping -->
                <TextBlock Grid.Row="3"
                           Text="Ping"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="-- ms"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- CPU usage -->
                <TextBlock Grid.Row="4"
                           Text="CPU Usage"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CpuUsageText"
                           Grid.Row="4"
                           Grid.Column="1"
                           Text="-- %"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- RAM usage -->
                <TextBlock Grid.Row="5"
                           Text="RAM Usage"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="RamUsageText"
                           Grid.Row="5"
                           Grid.Column="1"
                           Text="-- MB"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Committed memory -->
                <TextBlock Grid.Row="6"
                           Text="Committed Memory"
                           Foreground="#B8C7D3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CommittedMemoryText"
                           Grid.Row="6"
                           Grid.Column="1"
                           Text="-- MB"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>