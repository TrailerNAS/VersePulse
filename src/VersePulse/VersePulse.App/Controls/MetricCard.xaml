<UserControl x:Class="VersePulse.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="170"
             MinHeight="120">

    <Border
        Margin="8"
        Padding="16"
        Width="170"
        Height="120"
        CornerRadius="12"
        Background="#18212B"
        BorderBrush="#344454"
        BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card Title -->

            <TextBlock
                Grid.Row="0"
                Text="{Binding Title, ElementName=Root}"
                Foreground="#8FA7BB"
                FontSize="12"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <!-- Main Value -->

            <TextBlock
                Grid.Row="1"
                Text="{Binding Value, ElementName=Root}"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <!-- Optional Subtitle -->

            <TextBlock
                Grid.Row="2"
                Text="{Binding Subtitle, ElementName=Root}"
                Foreground="#7A8C9E"
                FontSize="11"
                HorizontalAlignment="Center"
                TextAlignment="Center"/>

        </Grid>

    </Border>

</UserControl>